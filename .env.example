# Hardhat deployment
SEPOLIA_RPC_URL=https://ethereum-sepolia-rpc.publicnode.com
SEPOLIA_PRIVATE_KEY=0xYOUR_DEPLOYER_PRIVATE_KEY
TREASURY_ADDRESS=0xYOUR_FEE_TREASURY
DEMO_USER_ADDRESS=0xOPTIONAL_USER_TO_RECEIVE_MOCK_USDT

# Set these after deployment
TOKEN_ADDRESS=0xDEPLOYED_MOCK_USDT
FORWARDER_ADDRESS=0xDEPLOYED_ERC2771_FORWARDER
RECIPIENT_ADDRESS=0xDEPLOYED_GASLESS_TRANSFER

# Relayer uses a funded Sepolia account. Keep this key server-side only.
# Accepts 64 hex characters, with or without the 0x prefix.
RELAYER_PRIVATE_KEY=0xYOUR_FUNDED_RELAYER_PRIVATE_KEY
RELAYER_PORT=8787
RELAYER_FEE_USDT=10000
RELAYER_MAX_GAS=350000
RELAYER_MAX_AMOUNT=100000000000
RELAYER_CORS_ORIGIN=http://localhost:5173,http://127.0.0.1:5173

# Browser app
VITE_RELAYER_URL=http://localhost:8787
